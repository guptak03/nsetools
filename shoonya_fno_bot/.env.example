# Copy to .env and fill your credentials
SHOONYA_USER=
SHOONYA_PASSWORD=
# For automated TOTP, put your TOTP secret (base32). If empty, the script will expect OTP via env each run.
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=

# Comma separated list of F&O underlying symbols to scan
WATCHLIST=RELIANCE, HDFCBANK, TCS, ICICIBANK, INFY, SBIN, LT, ITC, AXISBANK, KOTAKBANK

# Product type: I (MIS, intraday) or M (NRML)
PRODUCT_TYPE=I
# Lots per buy
LOTS_PER_ORDER=1
# Place at most one buy per symbol per day (true/false)
ONCE_PER_DAY=true
# 5-minute polling interval seconds
POLL_INTERVAL_SEC=20