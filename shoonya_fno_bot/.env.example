# Copy to .env and fill your credentials
SHOONYA_USER=
SHOONYA_PASSWORD=
# For automated TOTP, put your TOTP secret (base32). If empty, the script will expect OTP via env each run.
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=

# Segment: EQ for equity (cash), FNO for futures/options
TRADE_SEGMENT=EQ
# For EQ: number of shares per order; For FNO: lots per order
QUANTITY_PER_ORDER=10

# Comma separated list of symbols to scan (underlying names)
WATCHLIST=RELIANCE, HDFCBANK, TCS, ICICIBANK, INFY, SBIN, LT, ITC, AXISBANK, KOTAKBANK

# Product type: I (MIS, intraday) or C (CNC, delivery). For F&O use I or M (NRML)
PRODUCT_TYPE=I
# Place at most one buy per symbol per day (true/false)
ONCE_PER_DAY=true
# 5-minute polling interval seconds
POLL_INTERVAL_SEC=20